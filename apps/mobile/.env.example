# Copie para .env (mesma pasta) e preencha. O .env NUNCA vai para o git.
# Variáveis EXPO_PUBLIC_* vão DENTRO do APK: só coloque aqui o que pode ser público.
# NUNCA coloque aqui a service_role, a senha do banco nem chaves do PowerSync (RNF-18).

# URL do projeto Supabase (Project Settings → API → Project URL).
EXPO_PUBLIC_SUPABASE_URL=

# Chave pública do Supabase (anon / publishable). Sozinha não lê nada: a RLS fica sem
# políticas públicas (FIN-US-01.4).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Id do projeto no EAS (criado pelo dono com `eas init`). Liga o EAS Update.
EAS_PROJECT_ID=
