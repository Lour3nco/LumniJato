# Copie para .env (mesma pasta) e preencha. O .env NUNCA vai para o git.
# Na hospedagem, configure as mesmas variáveis no painel do provedor.

# Porta HTTP da API (padrão 3000).
PORTA=3000

# Conexão com o Postgres. OBRIGATÓRIA: sem ela a API não sobe.
# Fora do computador local a API SÓ aceita o papel api_lavajato (FIN-US-01.4), pelo pooler:
# postgresql://api_lavajato.<project-ref>:<senha>@<host-do-pooler>:5432/postgres
# No Supabase local (pnpm db:iniciar) pode usar:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# URL do projeto Supabase (OBRIGATÓRIA): a API valida o login (JWT) pelas chaves públicas dele.
# No Supabase local: http://127.0.0.1:54321
SUPABASE_URL=
