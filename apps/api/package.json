{
  "name": "@lavajato/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS do Lavajato (DDD, Clean Architecture, monólito modular). Dona das regras de domínio.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test && pnpm run lint:fronteiras",
    "lint:fronteiras": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@lavajato/contratos": "workspace:*",
    "@lavajato/dominio-compartilhado": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.28.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
